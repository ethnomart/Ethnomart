# Hostinger: set these in hPanel, not in GitHub.
NODE_ENV=production
TRUST_PROXY=1

# Optional: true shows the Coming soon page on every website route.
# The checked-in default is in shared/site-status.ts.
# Set false and restart/redeploy to reopen the full website.
# ETHNOMART_COMING_SOON=false

# Optional: your exact HTTPS origin or Hostinger temporary domain.
# PUBLIC_ORIGIN=https://your-domain.example

# Hostinger hbuilds layout is detected automatically. If detection is not possible,
# set a private absolute path outside nodejs, hbuilds and public_html:
# ETHNOMART_DATA_FILE=/home/USERNAME/domains/YOUR_DOMAIN/.ethnomart/catalogue.sqlite3

# Optional: otherwise a random signing secret is stored in the private database.
# SESSION_SECRET=generate-a-private-random-secret-of-at-least-32-characters

# Do not set PORT in hPanel; Hostinger supplies it. Local start defaults to 3000.
