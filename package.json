{
  "name": "ethnomart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.frontend.json && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env app.js",
    "dev": "vite --config vite.config.ts",
    "dev:api": "node --env-file-if-exists=.env server/src/dev.ts",
    "test": "node --test tests/*.test.mjs",
    "manager-link": "node --env-file-if-exists=.env dist/server/manager.mjs",
    "backup": "node --env-file-if-exists=.env dist/server/backup.mjs"
  },
